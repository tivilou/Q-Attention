    ],
    "forbidden": [
      "changing typed marker construction",
      "changing the upstream label IDs",
      "changing the entity-position readout",
      "changing the loss, optimizer, scheduler, or selection rule",
      "using test data for training or checkpoint selection"
    ]
  },
  "fidelity_gates": {
